{
  "name": "nikxel",
  "productName": "Nikxel",
  "version": "1.0.0",
  "description": "A tiny pixel desktop companion: watches your AI agents, records meetings and writes the notes, and bubbles up reminders.",
  "main": "dist/main/main.js",
  "author": "Nikhil Dhanda",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "check": "npm run build && node --test \"dist/checks/*.test.js\""
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "electron": true,
    "ffmpeg-static": true,
    "uiohook-napi": true,
    "electron-winstaller": true
  },
  "build": {
    "appId": "com.nikxel.Nikxel",
    "productName": "Nikxel",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "extraResources": [{ "from": "resources", "to": "resources" }],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/uiohook-napi/**"],
    "win": { "target": "nsis", "icon": "resources/icon.ico" },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true }
  }
}
